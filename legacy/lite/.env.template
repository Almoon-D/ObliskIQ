# ═══════════════════════════════════════════════════════════════
#  ObliskIQ-lite-MCP — environment
#  Copy to .env and fill. .gitignore covers .env itself.
#
#  This file is TRACKED and every value in it is EMPTY. It names the variables
#  and where to get each one; the values belong in .env, which is gitignored.
#
#  It used to carry working FRED, EIA and marketdata.app keys under a
#  private-repository caveat. They are gone from the template, but a value
#  committed once is in the history permanently and deleting the line does not
#  remove it: the remedy is to REISSUE those three keys. All three are free to
#  reissue, and tests/test_no_committed_secrets.py keeps a value from coming
#  back into this file.
# ═══════════════════════════════════════════════════════════════

# ── FRED — US + OECD international macro ───────────────────────
# Free key: https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=

# ── EIA — energy inventories, production, SPR ──────────────────
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── marketdata.app — US option chains, IV and greeks ───────────
# Free key: https://www.marketdata.app/  (dashboard -> request a token)
# Serves HISTORICAL end-of-day chains, which is what makes a year of chain history
# recoverable rather than permanently lost. NOTE the two credit tiers: the live
# tier bills PER OPTION SYMBOL (observed: 3 contracts = 3 credits), and the
# cheaper 1-per-1000 historical price is documented but NOT yet verified.
# Covers the twelve USD-listed collect_chain names; the three European listings
# (ASML, SAN, TTE) stay on IBKR, which is the only route that reaches them.
#
# ONE IP AT A TIME: the account blocks for five minutes whenever the source
# address changes, so collection must run from a host with a stable egress IP.
# A cloud agent sandbox rotates its egress and cannot hold this account.
MARKETDATA_API_TOKEN=

# ── Storage & runtime (deployment-agnostic) ────────────────────
OBLISK_DB_PATH=./data/obliskiq.db
OBLISK_CONFIG_PATH=./config.yaml
OBLISK_LOG_LEVEL=INFO
OBLISK_LOG_FORMAT=json               # json | text — json for the unattended VM
OBLISK_TZ=Europe/Madrid

# ── MCP server  (obliskiq-mcp http) ────────────────────────────
# Needed only by the `http` transport. `obliskiq-mcp stdio` binds nothing and
# reads none of these — that is the one for a local Claude Code session.
#
# The server REFUSES TO START on a non-loopback interface without a token, before
# anything binds. It holds the position ledger, and the ledger writes are the only
# mutating tools it exposes. There is NO order-staging tool: staging runs through
# the IBKR MCP connector under the rule SKILL.md states. See BUILD-BRIEF.md.
OBLISK_MCP_HOST=127.0.0.1
OBLISK_MCP_PORT=8000
OBLISK_MCP_AUTH_TOKEN=               # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"

# ── IBKR Client Portal Web API — OAuth 1.0a self-service ───────
# Registered through IBKR's web form. No download, no gateway, no browser
# session: this is the route that runs headless on the collector VM.
#
# The downloadable Client Portal Gateway and IB Gateway are OUT OF SCOPE.
# Both need an interactive local login and cannot run unattended.
OBLISK_IBKR_CP_BASE_URL=https://api.ibkr.com
# The IBKR Custom Connector's remote MCP endpoint. Read only by
# `obliskiq-collect connector`, which walks its OAuth 2.0 discovery documents
# and sends no credentials. No collector reads it; leaving it unset is fine.
OBLISK_IBKR_CONNECTOR_URL=https://api.ibkr.com/v1/api/mcp-public
OBLISK_IBKR_CONSUMER_KEY=
OBLISK_IBKR_ACCESS_TOKEN=
OBLISK_IBKR_ACCESS_TOKEN_SECRET=     # base64 ciphertext as IBKR issued it

# Private keys, as file paths. Never inline the key material.
OBLISK_IBKR_SIGNATURE_KEY=./secrets/signature.pem
OBLISK_IBKR_ENCRYPTION_KEY=./secrets/encryption.pem
OBLISK_IBKR_DH_PARAM=./secrets/dhparam.pem

# Optional custom CA bundle. TLS verification is never disabled: an unreadable
# bundle is a startup error, not a downgrade.
OBLISK_IBKR_CA_BUNDLE=

# The IBKR MCP connector is configured in the client, not here.
# No credentials for it belong in this file.

# ── Sources without a key ──────────────────────────────────────
# |Source         |Endpoint                  |Gives you                                  |
# |---------------|--------------------------|-------------------------------------------|
# |ECB Data Portal|`data-api.ecb.europa.eu`  |€STR, ECB rates, HICP, EUR effective rate  |
# |CFTC (Socrata) |`publicreporting.cftc.gov`|Commitments of Traders, weekly             |
