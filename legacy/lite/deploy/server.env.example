# ═══════════════════════════════════════════════════════════════
#  /etc/obliskiq/server.env  —  chmod 0600, owner obliskiq
#
#  Read by obliskiq-mcp.service. Holds the auth token, so it is NOT in git and
#  is NOT the same file as the repository's .env.template.
#
#  Deliberately separate from collect.env. The server needs NO IBKR credentials
#  and NO macro API keys: it makes no network requests of its own, and live
#  quotes, positions and NAV are passed in by the caller. The collectors need no
#  auth token: they bind no port. Keeping the two files apart means neither set
#  of secrets can leak through the other process.
# ═══════════════════════════════════════════════════════════════

OBLISK_DB_PATH=/var/lib/obliskiq/obliskiq.db
OBLISK_CONFIG_PATH=/opt/obliskiq/config.yaml
OBLISK_LOG_LEVEL=INFO
OBLISK_LOG_FORMAT=json
OBLISK_TZ=UTC

# ── the MCP server ──
# 127.0.0.1 keeps it on the machine; put a TLS-terminating reverse proxy in
# front of it and let that connect over loopback. Binding 0.0.0.0 directly means
# the token is the ONLY thing between the internet and the ledger.
OBLISK_MCP_HOST=127.0.0.1
OBLISK_MCP_PORT=8000

# Required whenever OBLISK_MCP_HOST is not loopback: the server REFUSES TO START
# without it, before anything binds. Generate with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate by editing this file and restarting the unit; every client needs the
# new value, so rotate deliberately rather than on a schedule nobody tracks.
OBLISK_MCP_AUTH_TOKEN=
