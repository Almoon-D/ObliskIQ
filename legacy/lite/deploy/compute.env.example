# Environment for the obliskiq-lite computation layer.
#
#   install -m 0640 -o obliskiq -g obliskiq deploy/compute.env.example \
#       /etc/obliskiq/compute.env
#
# Deliberately SEPARATE from collect.env, and deliberately holds no credential of
# any kind. The computation layer reads the store the collectors filled and
# writes derived tables back; it makes no request to anything. Its systemd unit
# enforces that with PrivateNetwork=true, and this file is the second half of the
# same guarantee: a process that cannot connect and has nothing to connect WITH.
#
# It follows that this file is not a secret and does not need mode 0600. Keep it
# that way — the moment an API key appears here, both halves are gone.

# Where the store lives. The one setting load_settings() refuses to default: a
# wrong path would silently build a grid over an empty database.
OBLISK_DB_PATH=/var/lib/obliskiq/obliskiq.db

# Thresholds and windows. Every one of them, without exception.
OBLISK_CONFIG_PATH=/opt/obliskiq/config.yaml

OBLISK_LOG_LEVEL=INFO
OBLISK_LOG_FORMAT=json

# UTC everywhere, so nothing shifts under daylight saving and a row written by
# the collectors sorts against one written here.
OBLISK_TZ=UTC
