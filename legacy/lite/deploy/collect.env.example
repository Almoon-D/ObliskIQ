# ═══════════════════════════════════════════════════════════════
#  /etc/obliskiq/collect.env  —  chmod 0600, owner obliskiq
#
#  Read by the systemd unit and by cron via BASH_ENV. Holds API keys, so it is
#  NOT in git and is not the same file as the repository's .env.template.
#
#  The collectors need no MCP server variables: they bind no port.
#
#  RUNNING A COMMAND BY HAND. `sudo -u obliskiq ...` does NOT read this file —
#  EnvironmentFile= is a systemd directive and sudo knows nothing about it, so a
#  hand-run command starts with none of these set and stops at
#  "required environment variable OBLISK_DB_PATH is unset or empty". Point
#  OBLISK_ENV_FILE at this file and the loader reads it itself:
#
#    sudo -u obliskiq OBLISK_ENV_FILE=/etc/obliskiq/collect.env \
#         /opt/obliskiq/.venv/bin/obliskiq-collect status
# ═══════════════════════════════════════════════════════════════

OBLISK_DB_PATH=/var/lib/obliskiq/obliskiq.db
OBLISK_CONFIG_PATH=/opt/obliskiq/config.yaml
OBLISK_LOG_LEVEL=INFO
OBLISK_LOG_FORMAT=json
OBLISK_TZ=UTC

# ── IBKR Client Portal Web API, OAuth 1.0a self-service ──
# Registered through a web form in IBKR account settings. No download, no
# browser session: this is the route that runs headless.
OBLISK_IBKR_CP_BASE_URL=https://api.ibkr.com
# The IBKR Custom Connector's remote MCP endpoint. Read only by
# `obliskiq-collect connector`, which walks its OAuth 2.0 discovery documents
# and sends no credentials. No collector reads it; leaving it unset is fine.
OBLISK_IBKR_CONNECTOR_URL=https://api.ibkr.com/v1/api/mcp-public
OBLISK_IBKR_CONSUMER_KEY=
OBLISK_IBKR_ACCESS_TOKEN=
OBLISK_IBKR_ACCESS_TOKEN_SECRET=
OBLISK_IBKR_SIGNATURE_KEY=/etc/obliskiq/secrets/signature.pem
OBLISK_IBKR_ENCRYPTION_KEY=/etc/obliskiq/secrets/encryption.pem
OBLISK_IBKR_DH_PARAM=/etc/obliskiq/secrets/dhparam.pem

# A custom trust store, when the host needs one. Optional, and it is a PATH
# rather than a credential. Set it and the file must be readable: an
# unreadable bundle is a startup error and never a downgrade, because the
# alternative — disabling TLS verification to get past it — is not on offer
# anywhere in this package.
OBLISK_IBKR_CA_BUNDLE=

# ── Macro sources ──
FRED_API_KEY=
EIA_API_KEY=

# ── Option chains (marketdata.app) ──
# Historical and end-of-day US option chains with IV and greeks. This is the
# route the twelve USD-listed collect_chain names use; the three European
# listings stay on IBKR, which is the only source that covers them.
# NOTE: the account is limited to ONE IP at a time and blocks for five minutes
# on a change, so run collection from a host with a stable egress address.
MARKETDATA_API_TOKEN=
