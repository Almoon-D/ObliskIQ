# ObliskIQ environment. Copy to .env (gitignored) or set these in the deployment's
# environment. This template names every variable ObliskIQ reads and holds no values.
# Credentials are paper-only in cloud sessions (AGENTS.md); never commit a filled copy.

# ── Data sources ──────────────────────────────────────────────────────────────
FRED_API_KEY=
EIA_API_KEY=
# A contact string SEC EDGAR requires, e.g. "ObliskIQ research <your email>".
SEC_USER_AGENT=

# ── LLM (named by config/llm.yaml `key_env`; without it the EventExtractor is skipped and
# its items wait) ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Telegram (cockpit and alerts) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Health ────────────────────────────────────────────────────────────────────
# Optional: an https URL the service fetches after each heartbeat (a dead man's switch such as
# a healthchecks.io check). It is a secret: anyone holding it can report the bot alive.
OBLISK_HEALTH_PING_URL=

# ── IBKR ──────────────────────────────────────────────────────────────────────
# paper | live. Cloud sessions use paper only.
OBLISK_IBKR_PROFILE=
# The paper account id starts with DU.
OBLISK_IBKR_ACCOUNT_ID=
# gateway | oauth
OBLISK_IBKR_TRANSPORT=

# Client Portal Gateway login (transport gateway).
OBLISK_IBKR_GATEWAY_USERNAME=
OBLISK_IBKR_GATEWAY_PASSWORD=
# The Java runtime the Gateway runs on (a JAVA_HOME). Default: the java on PATH. Its major
# version must be one ibkr.gateway.java_major_versions lists.
OBLISK_IBKR_GATEWAY_JAVA_HOME=

# OAuth 1.0a (transport oauth): the LIVE account only (DECISIONS D42). Never set in a cloud
# environment; a paper run uses the Gateway and never reads these. The base URL has no path,
# e.g. https://api.ibkr.com.
OBLISK_IBKR_CP_BASE_URL=
OBLISK_IBKR_CONSUMER_KEY=
OBLISK_IBKR_ACCESS_TOKEN=
OBLISK_IBKR_ACCESS_TOKEN_SECRET=
# Paths to the key files, never the keys themselves.
OBLISK_IBKR_SIGNATURE_KEY=
OBLISK_IBKR_ENCRYPTION_KEY=
OBLISK_IBKR_DH_PARAM=

# ── Locations ─────────────────────────────────────────────────────────────────
# The directory holding owner.yaml, defaults/ and jurisdictions/ (default: config/ of
# the source checkout).
OBLISK_CONFIG_DIR=
# Where runtime state lives (the store, the settings audit log). No default.
OBLISK_DATA_DIR=

# ── Logging overrides for one process (defaults live in config/defaults/logging.yaml) ──
# DEBUG | INFO | WARNING | ERROR | CRITICAL
OBLISK_LOG_LEVEL=
# json | text
OBLISK_LOG_FORMAT=
