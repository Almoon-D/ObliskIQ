# /etc/obliskiq/obliskiq.env: the machine's secrets and switches, read by both containers
# (`docker run --env-file`) and by deploy/backup.sh. chmod 600, owned by root; never in git.
# The names are the repository's .env.example; this file lists what a machine sets.

# ── IBKR: the PAPER account until promotion (docs/DEPLOY.md) ──
OBLISK_IBKR_PROFILE=paper
OBLISK_IBKR_TRANSPORT=gateway
# The paper account id (it starts with DU) and the paper login.
OBLISK_IBKR_ACCOUNT_ID=
OBLISK_IBKR_GATEWAY_USERNAME=
OBLISK_IBKR_GATEWAY_PASSWORD=

# ── Telegram: alerts, the digest, the dashboard and the owner's commands ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── The cockpit's bearer token (python3 -c "import secrets; print(secrets.token_urlsafe(48))") ──
OBLISK_MCP_AUTH_TOKEN=

# ── Health: a dead man's switch the service pings after each heartbeat (healthchecks.io) ──
OBLISK_HEALTH_PING_URL=

# ── Data sources and the analyst's model ──
FRED_API_KEY=
EIA_API_KEY=
SEC_USER_AGENT=
GEMINI_API_KEY=

# ── The nightly backup's off-machine target: any rclone remote and path, e.g. b2:obliskiq ──
OBLISK_BACKUP_REMOTE=
